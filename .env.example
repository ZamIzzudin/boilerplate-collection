# Base URL API genesis (opsional, default http://localhost:4000/)
VITE_API_BASE_URL=http://localhost:4000/

# Base URL API utama. Saat dev, biarkan "/api" (diproxy vite ke backend express).
VITE_API_BASE_URL_NEW=/api

# Nama cookie session (harus sama dengan SESSION_COOKIE_NAME di backend)
VITE_SESSION_COOKIE_NAME=internal_session

# Key enkripsi AES (harus identik dengan APP_KEY di backend).
# Format: "base64:<random-32-bytes>" atau plain string (dipotong/di-pad ke ukuran key).
# Generate: openssl rand -base64 32
VITE_APP_KEY=base64:c3VwZXJzZWNyZXRrZXlib2lsZXJwbGF0ZTEyMzQ1Njc4OQ==

# Cipher yang dipakai (default: aes-256-cbc)
VITE_APP_CIPHER=aes-256-cbc
