# Server
NODE_ENV=development
PORT=4000

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/boilerplate?schema=public

# JWT
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_TTL=1800
REFRESH_TOKEN_TTL=604800

# Cookies (SESSION_COOKIE_NAME harus sama dengan VITE_SESSION_COOKIE_NAME di frontend)
SESSION_COOKIE_NAME=internal_session
ACCESS_COOKIE_NAME=access_token
# COOKIE_DOMAIN=.example.com
# COOKIE_SECURE=true

# AES key — HARUS sama dengan VITE_APP_KEY di frontend
APP_KEY=base64:c3VwZXJzZWNyZXRrZXlib2lsZXJwbGF0ZTEyMzQ1Njc4OQ==
APP_CIPHER=aes-256-cbc

# CORS (origin frontend, dipisah koma)
CORS_ORIGINS=http://localhost:5173

# Base URL frontend untuk link email reset/aktivasi
APP_URL=http://localhost:5173

# Seed admin awal
SEED_ADMIN_EMAIL=admin@boilerplate.local
SEED_ADMIN_PASSWORD=Admin123!
